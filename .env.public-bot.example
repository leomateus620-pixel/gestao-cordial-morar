# Server-only. Copy names into the project's secure settings, never into VITE variables.
PUBLIC_BOT_DATABASE_REST_URL=
PUBLIC_BOT_GATEWAY_KEY=
PUBLIC_BOT_GATEWAY_SECRET=
PUBLIC_BOT_IP_SECRET=
# Set only after verifying the actual ingress on BOTH brand hosts and alternate origins.
PUBLIC_BOT_TRUSTED_IP_HEADER=
PUBLIC_BOT_INGRESS_VERIFIED=false
# Existing LOVABLE_API_KEY is used if these overrides are empty.
PUBLIC_BOT_AI_KEY=
PUBLIC_BOT_AI_MODEL=google/gemini-3.1-flash-lite
PUBLIC_BOT_VOICE_KEY=
PUBLIC_BOT_VOICE_MODEL=openai/gpt-transcribe
