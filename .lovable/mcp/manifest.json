        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "diasParado": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "marketing_performance",
        "title": "Desempenho de marketing",
        "description": "Resultados das campanhas permitidas. Investimento e CPL somente para o administrador.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "imobiliaria": {
              "type": "string",
              "enum": [
                "cordial",
                "morar"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_properties",
