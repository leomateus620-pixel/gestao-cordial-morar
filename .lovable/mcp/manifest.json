        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "portfolio_summary",
        "title": "Resumo da carteira",
        "description": "Resumo limitado da carteira compartilhada por situação, finalidade, imobiliária e cidade.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "cidade": {
              "type": "string",
              "maxLength": 80
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
